# Per-project manifest. Agents read this file first every session.
# On install, copy to `.ai/project.yaml` and fill in project-specific
# fields. Commit the copy; this `.example` stays as the scaffold
# reference.

project:
  name: "example-mobile-app"
  type: react-native
  stacks: [react-native]
  # domain: payments   # set when a domain terminology set applies

rules:
  load:
    - global/*
    - stacks/react-native/*
    # - local/*   # enable once `.ai/rules/local/` has content
    #             # (local is added in a later stage)

personas:
  enabled: [architect, product-analyst, implementer]
  ownership:
    architect:       [specs, decisions]
    product-analyst: [briefs]
    implementer:     [plans]
  # Reviewer, tester, and security-reviewer come online in
  # Stage 6. Do not list a persona whose file does not yet
  # exist — agents will try to load it and fail.

# terminology:
#   load: [global]
# Terminology files are introduced in a later stage. Uncomment
# once `.ai/terminology/global.md` exists.

paths:
  briefs: docs/briefs
  specs: docs/specs
  plans: docs/plans
  decisions: docs/decisions
  index: docs/README.md
