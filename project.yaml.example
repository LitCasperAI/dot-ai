# Per-project manifest. Agents read this file first every session.
# On install, copy to `.ai-local/project.yaml` and fill in project-specific
# fields. Commit the copy; this `.example` stays as the scaffold
# reference.
#
# SECURITY: Never store secrets, API keys, or sensitive local-only paths
# in .ai-local/project.yaml. This file is intended to be committed.

project:
  name: "example-mobile-app"
  type: react-native
  stacks: [react-native]
  domain: retail

rules:
  # Core rules are loaded at the start of every session.
  core:
    - .ai/rules/global/00-intent-routing.md
    - .ai/rules/global/01-principles.md
    - .ai/rules/global/02-agent-conduct.md
    - .ai/rules/global/11-validation-discipline.md
    - .ai/rules/global/14-safety-enforcement.md
    - .ai/rules/global/15-memory-management.md
  # Contextual rules are loaded dynamically based on the active skill or persona.
  contextual:
    - .ai/rules/global/*
    - .ai/rules/stacks/react-native/*
    - .ai-local/rules/*

personas:
  enabled: [architect, auditor, dependency-manager, designer, implementer, product-analyst, release-engineer, reviewer, security-reviewer, tester]
  ownership:
    architect:       [specs, decisions]
    product-analyst: [briefs]
    implementer:     [plans]
    designer:        [design_system, design_system_global]

terminology:
  # Always loaded, in order. .ai-local/terminology/*.md wins on
  # same-filename collision with .ai/terminology/*.md.
  load:
    - .ai/terminology/*.md
    - .ai-local/terminology/*.md

paths:
  briefs: docs/briefs
  specs: docs/specs
  plans: docs/plans
  decisions: docs/decisions
  design_system: docs/design-system.md
  design_system_global: .ai/design-system.md
  index: docs/README.md

# Optional. Omit entirely, or set type: local, for "no remote
# tracker" — every publish/sync/close call in
# 17-tracker-integration.md becomes a documented no-op. Never put a
# credential value here; credential_env names an environment
# variable the agent reads at call time.
#
# tracker:
#   type: gitlab                  # gitlab | github | jira | local
#   url: https://gitlab.example.com
#   project: group/subgroup/project
#   credential_env: GITLAB_TOKEN
#   label_prefix: ai-plan         # optional, default "ai-plan"
#
# tracker:
#   type: github
#   url: https://api.github.com
#   project: my-org/my-repo
#   credential_env: GITHUB_TOKEN
#   label_prefix: ai-plan
#
# tracker:
#   type: jira
#   url: https://my-org.atlassian.net
#   project: PROJ
#   credential_env: JIRA_TOKEN
#   label_prefix: ai-plan
#
# tracker:
#   type: local
